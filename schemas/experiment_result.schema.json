{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientist-lab.local/schemas/experiment_result.schema.json",
  "title": "ExperimentResult",
  "description": "Canonical experiment outcome after ResultParser. Scientific meaning is Reviewer's job.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "metrics",
    "artifacts",
    "execution"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "run_id": { "$ref": "common.schema.json#/$defs/non_empty_string" },
    "experiment_sha": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/sha" },
        { "type": "null" }
      ]
    },
    "metrics": { "$ref": "common.schema.json#/$defs/canonical_metrics" },
    "metrics_delta": {
      "type": "object",
      "additionalProperties": { "type": ["number", "null"] },
      "description": "Optional deltas vs parent/best; filled by deterministic services."
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "missing_expected": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success", "failed", "timeout", "cancelled"]
        },
        "exit_code": { "type": ["integer", "null"] },
        "runtime_seconds": { "type": ["number", "null"] },
        "error_type": {
          "type": ["string", "null"],
          "description": "e.g. OOM, CUDA_ERROR, IO_ERROR — for ExceptionHandler, not Reviewer."
        },
        "error_message": { "type": ["string", "null"] }
      }
    },
    "scientific_outcome": {
      "$ref": "common.schema.json#/$defs/scientific_outcome"
    },
    "constraints_check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ok": { "type": "boolean" },
        "violations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "raw_metric_refs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths to model-specific raw metric files before normalization."
    }
  }
}
