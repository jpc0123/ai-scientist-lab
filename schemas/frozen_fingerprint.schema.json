{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientist-lab.local/schemas/frozen_fingerprint.schema.json",
  "title": "FrozenResearchFingerprint",
  "description": "Comparability Contract snapshot. Semantic identity of evaluation conditions; Adapter maps model code onto this, not a forced unified harness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fingerprint_id",
    "protocol_id",
    "protocol_version"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "fingerprint_id": { "$ref": "common.schema.json#/$defs/non_empty_string" },
    "protocol_id": { "$ref": "common.schema.json#/$defs/non_empty_string" },
    "protocol_version": { "type": "integer", "minimum": 1 },
    "dataset_split_hash": { "$ref": "common.schema.json#/$defs/hex_hash" },
    "evaluator_hash": { "$ref": "common.schema.json#/$defs/hex_hash" },
    "metric_definition_hash": { "$ref": "common.schema.json#/$defs/hex_hash" },
    "baseline_config_hash": { "$ref": "common.schema.json#/$defs/hex_hash" },
    "annotation_version": { "$ref": "common.schema.json#/$defs/non_empty_string" },
    "data_manifest_hash": { "$ref": "common.schema.json#/$defs/hex_hash" },
    "notes": { "type": "string" }
  }
}
