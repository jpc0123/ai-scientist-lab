# CPU plugin-author composition. Not the GPU experiment image.
# Uses dsh-llm-pi-ai so OpenAI-compatible gateways (Aliyun Qwen) work.
# Secrets stay in the environment; this file names no key.

- id: sdk-jsonrpc-server
  name: '@deepseek-ai/dsh-sdk-jsonrpc-server'

- id: agent-core
  name: '@deepseek-ai/dsh-agent-spine-demo'
  config:
    workspaceContext:
      maxBytes: 65536

- id: llm
  name: '@deepseek-ai/dsh-llm-pi-ai'
  config:
    providers:
      lab:
        displayName: Lab OpenAI-compatible
        apiKeyEnv: DEEPSEEK_API_KEY
        api: openai-completions
        baseURL: __LAB_BASE_URL__
        compat:
          supportsDeveloperRole: false
          maxTokensField: max_tokens
          supportsReasoningEffort: false
        models:
          - id: __LAB_MODEL__
            contextWindow: 131072
            maxTokens: 8192
            reasoningEfforts: false

- id: sessions
  name: '@deepseek-ai/dsh-session-persistence-jsonl'
  config:
    root: !!js process.env.DSH_SESSION_ROOT ?? './.sessions'

- id: session-checkpoints
  name: '@deepseek-ai/dsh-session-checkpoint-policy'

- id: subprocess
  name: '@deepseek-ai/dsh-subprocess-local'

- id: bash
  name: '@deepseek-ai/dsh-bash-local'
  config:
    cwd: !!js process.env.DSH_CWD ?? process.cwd()

- id: fs-local
  name: '@deepseek-ai/dsh-fs-local'
  config:
    cwd: !!js process.env.DSH_CWD ?? process.cwd()

- id: tool-fs
  name: '@deepseek-ai/dsh-tool-fs'

- id: editor
  name: '@deepseek-ai/dsh-tool-str-replace-editor'
